// =============================================================
// Hospital MIS - Prisma Schema
// Complete database schema for the Hospital Information System
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============= AUTH & USERS =============
model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique
  passwordHash  String    @map("password_hash")
  role          UserRole
  isActive      Boolean   @default(true) @map("is_active")
  employeeId    Int?      @unique @map("employee_id")
  employee      Employee? @relation(fields: [employeeId], references: [id])
  auditLogs     AuditLog[]
  archiveUploads Archive[] @relation("uploader")
  archiveAccess  ArchiveAccessLog[]
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  DOCTOR
  NURSE
  LAB_TECH
  RADIOLOGY_TECH
  PHARMACIST
  RECEPTIONIST
  ACCOUNTANT
  HR
  ARCHIVIST
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  Int?     @map("entity_id")
  details   Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

// ============= HOSPITAL STRUCTURE =============
model Department {
  id          Int       @id @default(autoincrement())
  nameAr      String    @map("name_ar")
  nameEn      String    @map("name_en")
  type        DepartmentType
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  rooms       Room[]
  doctors     Doctor[]
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("departments")
}

enum DepartmentType {
  INPATIENT
  OUTPATIENT
  EMERGENCY
  ICU
  SURGERY
  LAB
  RADIOLOGY
  PHARMACY
  ADMIN
}

model Room {
  id           Int        @id @default(autoincrement())
  roomNumber   String     @map("room_number")
  departmentId Int        @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id])
  roomType     RoomType   @map("room_type")
  floor        Int
  beds         Bed[]
  isActive     Boolean    @default(true) @map("is_active")

  @@map("rooms")
}

enum RoomType {
  STANDARD
  SEMI_PRIVATE
  PRIVATE
  VIP
  ICU
  SURGERY
  EXAM
}

model Bed {
  id         Int         @id @default(autoincrement())
  bedNumber  String      @map("bed_number")
  roomId     Int         @map("room_id")
  room       Room        @relation(fields: [roomId], references: [id])
  status     BedStatus   @default(AVAILABLE)
  admissions Admission[]

  @@map("beds")
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

// ============= EMPLOYEES & DOCTORS =============
model Employee {
  id            Int       @id @default(autoincrement())
  fullNameAr    String    @map("full_name_ar")
  fullNameEn    String?   @map("full_name_en")
  nationalId    String?   @unique @map("national_id")
  phone         String?
  email         String?
  position      String
  departmentName String?  @map("department_name")
  hireDate      DateTime? @map("hire_date")
  salary        Decimal?  @db.Decimal(12, 2)
  isActive      Boolean   @default(true) @map("is_active")
  user          User?
  doctor        Doctor?
  shifts        Shift[]
  attendance    Attendance[]
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("employees")
}

model Doctor {
  id              Int        @id @default(autoincrement())
  employeeId      Int        @unique @map("employee_id")
  employee        Employee   @relation(fields: [employeeId], references: [id])
  specialty       String
  licenseNumber   String?    @map("license_number")
  departmentId    Int?       @map("department_id")
  department      Department? @relation(fields: [departmentId], references: [id])
  consultationFee Decimal?   @db.Decimal(10, 2) @map("consultation_fee")
  appointments    Appointment[]
  medicalRecords  MedicalRecord[]
  admissions      Admission[]
  labOrders       LabOrder[]
  radiologyOrders RadiologyOrder[]
  prescriptions   Prescription[]
  surgeries       Surgery[]

  @@map("doctors")
}

// ============= PATIENTS =============
model Patient {
  id               Int       @id @default(autoincrement())
  mrn              String    @unique
  nationalId       String?   @unique @map("national_id")
  fullNameAr       String    @map("full_name_ar")
  fullNameEn       String?   @map("full_name_en")
  dateOfBirth      DateTime? @map("date_of_birth")
  gender           Gender
  bloodType        BloodType? @map("blood_type")
  allergies        String?
  phone            String?
  phone2           String?
  email            String?
  address          String?
  city             String?
  emergencyContact String?   @map("emergency_contact")
  emergencyPhone   String?   @map("emergency_phone")
  photoUrl         String?   @map("photo_url")
  notes            String?
  isActive         Boolean   @default(true) @map("is_active")
  appointments     Appointment[]
  admissions       Admission[]
  medicalRecords   MedicalRecord[]
  labOrders        LabOrder[]
  radiologyOrders  RadiologyOrder[]
  prescriptions    Prescription[]
  invoices         Invoice[]
  insuranceCards   InsuranceCard[]
  archives         Archive[]
  vitalSigns       VitalSign[]
  surgeries        Surgery[]
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("patients")
}

enum Gender {
  MALE
  FEMALE
}

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

// ============= APPOINTMENTS =============
model Appointment {
  id           Int               @id @default(autoincrement())
  patientId    Int               @map("patient_id")
  patient      Patient           @relation(fields: [patientId], references: [id])
  doctorId     Int               @map("doctor_id")
  doctor       Doctor            @relation(fields: [doctorId], references: [id])
  scheduledAt  DateTime          @map("scheduled_at")
  endAt        DateTime?         @map("end_at")
  status       AppointmentStatus @default(SCHEDULED)
  type         VisitType         @default(CONSULTATION)
  notes        String?
  cancelReason String?           @map("cancel_reason")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@map("appointments")
}

enum AppointmentStatus {
  SCHEDULED
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum VisitType {
  CONSULTATION
  FOLLOW_UP
  EMERGENCY
  PROCEDURE
}

// ============= ADMISSIONS (ADT) =============
model Admission {
  id               Int             @id @default(autoincrement())
  patientId        Int             @map("patient_id")
  patient          Patient         @relation(fields: [patientId], references: [id])
  doctorId         Int             @map("doctor_id")
  doctor           Doctor          @relation(fields: [doctorId], references: [id])
  bedId            Int?            @map("bed_id")
  bed              Bed?            @relation(fields: [bedId], references: [id])
  admittedAt       DateTime        @default(now()) @map("admitted_at")
  dischargedAt     DateTime?       @map("discharged_at")
  status           AdmissionStatus @default(ADMITTED)
  admissionReason  String?         @map("admission_reason")
  dischargeSummary String?         @map("discharge_summary")
  dischargeNotes   String?         @map("discharge_notes")
  transfers        Transfer[]
  vitalSigns       VitalSign[]
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@map("admissions")
}

enum AdmissionStatus {
  ADMITTED
  TRANSFERRED
  DISCHARGED
  DECEASED
}

model Transfer {
  id          Int       @id @default(autoincrement())
  admissionId Int       @map("admission_id")
  admission   Admission @relation(fields: [admissionId], references: [id])
  fromBedId   Int       @map("from_bed_id")
  toBedId     Int       @map("to_bed_id")
  reason      String?
  transferredAt DateTime @default(now()) @map("transferred_at")
  transferredBy String?  @map("transferred_by")

  @@map("transfers")
}

model VitalSign {
  id            Int        @id @default(autoincrement())
  patientId     Int        @map("patient_id")
  patient       Patient    @relation(fields: [patientId], references: [id])
  admissionId   Int?       @map("admission_id")
  admission     Admission? @relation(fields: [admissionId], references: [id])
  temperature   Decimal?   @db.Decimal(4, 1)
  bloodPressureSystolic  Int? @map("bp_systolic")
  bloodPressureDiastolic Int? @map("bp_diastolic")
  heartRate     Int?       @map("heart_rate")
  respiratoryRate Int?     @map("respiratory_rate")
  oxygenSaturation Decimal? @db.Decimal(5, 2) @map("oxygen_saturation")
  weight        Decimal?   @db.Decimal(6, 2)
  height        Decimal?   @db.Decimal(5, 2)
  notes         String?
  recordedAt    DateTime   @default(now()) @map("recorded_at")
  recordedBy    String?    @map("recorded_by")

  @@map("vital_signs")
}

// ============= MEDICAL RECORDS (EMR) =============
model MedicalRecord {
  id          Int       @id @default(autoincrement())
  patientId   Int       @map("patient_id")
  patient     Patient   @relation(fields: [patientId], references: [id])
  doctorId    Int       @map("doctor_id")
  doctor      Doctor    @relation(fields: [doctorId], references: [id])
  visitType   VisitType @map("visit_type")
  icd10Code   String?   @map("icd10_code")
  icd10Desc   String?   @map("icd10_desc")
  subjective  String?
  objective   String?
  assessment  String?
  plan        String?
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("medical_records")
}

model Surgery {
  id            Int       @id @default(autoincrement())
  patientId     Int       @map("patient_id")
  patient       Patient   @relation(fields: [patientId], references: [id])
  doctorId      Int       @map("doctor_id")
  doctor        Doctor    @relation(fields: [doctorId], references: [id])
  surgeryName   String    @map("surgery_name")
  surgeryDate   DateTime  @map("surgery_date")
  anesthesiaType String?  @map("anesthesia_type")
  duration      Int?
  complications String?
  notes         String?
  status        SurgeryStatus @default(SCHEDULED)
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("surgeries")
}

enum SurgeryStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ============= LABORATORY (LIS) =============
model LabTest {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  nameAr      String    @map("name_ar")
  nameEn      String    @map("name_en")
  category    String
  normalRange String?   @map("normal_range")
  unit        String?
  price       Decimal   @db.Decimal(10, 2)
  isActive    Boolean   @default(true) @map("is_active")
  labResults  LabResult[]

  @@map("lab_tests")
}

model LabOrder {
  id          Int          @id @default(autoincrement())
  orderNumber String       @unique @map("order_number")
  patientId   Int          @map("patient_id")
  patient     Patient      @relation(fields: [patientId], references: [id])
  doctorId    Int          @map("doctor_id")
  doctor      Doctor       @relation(fields: [doctorId], references: [id])
  status      LabOrderStatus @default(PENDING)
  priority    Priority     @default(ROUTINE)
  notes       String?
  results     LabResult[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("lab_orders")
}

enum LabOrderStatus {
  PENDING
  SAMPLE_COLLECTED
  IN_PROGRESS
  COMPLETED
  APPROVED
  CANCELLED
}

enum Priority {
  ROUTINE
  URGENT
  STAT
}

model LabResult {
  id          Int       @id @default(autoincrement())
  orderId     Int       @map("order_id")
  order       LabOrder  @relation(fields: [orderId], references: [id])
  testId      Int       @map("test_id")
  test        LabTest   @relation(fields: [testId], references: [id])
  resultValue String?   @map("result_value")
  isAbnormal  Boolean   @default(false) @map("is_abnormal")
  notes       String?
  performedBy String?   @map("performed_by")
  resultAt    DateTime? @map("result_at")

  @@map("lab_results")
}

// ============= RADIOLOGY (RIS) =============
model RadiologyType {
  id       Int       @id @default(autoincrement())
  code     String    @unique
  nameAr   String    @map("name_ar")
  nameEn   String    @map("name_en")
  category String
  price    Decimal   @db.Decimal(10, 2)
  isActive Boolean   @default(true) @map("is_active")
  orders   RadiologyOrder[]

  @@map("radiology_types")
}

model RadiologyOrder {
  id          Int                  @id @default(autoincrement())
  orderNumber String               @unique @map("order_number")
  patientId   Int                  @map("patient_id")
  patient     Patient              @relation(fields: [patientId], references: [id])
  doctorId    Int                  @map("doctor_id")
  doctor      Doctor               @relation(fields: [doctorId], references: [id])
  typeId      Int                  @map("type_id")
  type        RadiologyType        @relation(fields: [typeId], references: [id])
  status      RadiologyOrderStatus @default(PENDING)
  priority    Priority             @default(ROUTINE)
  clinicalInfo String?             @map("clinical_info")
  report      String?
  reportBy    String?              @map("report_by")
  images      RadiologyImage[]
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@map("radiology_orders")
}

enum RadiologyOrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REPORTED
  CANCELLED
}

model RadiologyImage {
  id       Int            @id @default(autoincrement())
  orderId  Int            @map("order_id")
  order    RadiologyOrder @relation(fields: [orderId], references: [id])
  filePath String         @map("file_path")
  fileName String         @map("file_name")
  fileSize Int            @map("file_size")
  uploadedAt DateTime     @default(now()) @map("uploaded_at")

  @@map("radiology_images")
}

// ============= PHARMACY & MEDICATIONS =============
model Medication {
  id               Int       @id @default(autoincrement())
  code             String    @unique
  tradeName        String    @map("trade_name")
  genericName      String    @map("generic_name")
  form             MedicationForm
  strength         String?
  manufacturer     String?
  category         String?
  price            Decimal   @db.Decimal(10, 2)
  currentStock     Int       @default(0) @map("current_stock")
  minimumStock     Int       @default(10) @map("minimum_stock")
  expiryDate       DateTime? @map("expiry_date")
  isControlled     Boolean   @default(false) @map("is_controlled")
  isActive         Boolean   @default(true) @map("is_active")
  prescriptionItems PrescriptionItem[]
  stockMovements   StockMovement[]
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("medications")
}

enum MedicationForm {
  TABLET
  CAPSULE
  SYRUP
  INJECTION
  CREAM
  OINTMENT
  DROPS
  INHALER
  SUPPOSITORY
  PATCH
  OTHER
}

model Prescription {
  id          Int                @id @default(autoincrement())
  patientId   Int                @map("patient_id")
  patient     Patient            @relation(fields: [patientId], references: [id])
  doctorId    Int                @map("doctor_id")
  doctor      Doctor             @relation(fields: [doctorId], references: [id])
  status      PrescriptionStatus @default(PENDING)
  notes       String?
  items       PrescriptionItem[]
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@map("prescriptions")
}

enum PrescriptionStatus {
  PENDING
  PARTIALLY_DISPENSED
  DISPENSED
  CANCELLED
}

model PrescriptionItem {
  id             Int          @id @default(autoincrement())
  prescriptionId Int          @map("prescription_id")
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  medicationId   Int          @map("medication_id")
  medication     Medication   @relation(fields: [medicationId], references: [id])
  dosage         String
  frequency      String
  duration       String?
  quantity       Int
  dispensed      Boolean      @default(false)
  dispensedAt    DateTime?    @map("dispensed_at")
  dispensedBy    String?      @map("dispensed_by")
  notes          String?

  @@map("prescription_items")
}

model StockMovement {
  id           Int           @id @default(autoincrement())
  medicationId Int           @map("medication_id")
  medication   Medication    @relation(fields: [medicationId], references: [id])
  type         MovementType
  quantity     Int
  reason       String?
  reference    String?
  performedBy  String?       @map("performed_by")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@map("stock_movements")
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  EXPIRED
  RETURN
}

// ============= BILLING & FINANCE =============
model Invoice {
  id            Int           @id @default(autoincrement())
  invoiceNumber String        @unique @map("invoice_number")
  patientId     Int           @map("patient_id")
  patient       Patient       @relation(fields: [patientId], references: [id])
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  paid          Decimal       @default(0) @db.Decimal(12, 2)
  status        InvoiceStatus @default(DRAFT)
  paymentMethod PaymentMethod? @map("payment_method")
  notes         String?
  items         InvoiceItem[]
  insuranceClaim InsuranceClaim?
  payments      Payment[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  INSURANCE
  MIXED
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int     @map("invoice_id")
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  description String
  category    String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2) @map("unit_price")
  total       Decimal @db.Decimal(12, 2)

  @@map("invoice_items")
}

model Payment {
  id        Int           @id @default(autoincrement())
  invoiceId Int           @map("invoice_id")
  invoice   Invoice       @relation(fields: [invoiceId], references: [id])
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod
  reference String?
  paidAt    DateTime      @default(now()) @map("paid_at")
  receivedBy String?      @map("received_by")

  @@map("payments")
}

// ============= INSURANCE =============
model InsuranceCompany {
  id           Int             @id @default(autoincrement())
  nameAr       String          @map("name_ar")
  nameEn       String?         @map("name_en")
  phone        String?
  email        String?
  address      String?
  contactPerson String?        @map("contact_person")
  contractStart DateTime?      @map("contract_start")
  contractEnd   DateTime?      @map("contract_end")
  discountRate  Decimal?       @db.Decimal(5, 2) @map("discount_rate")
  isActive     Boolean         @default(true) @map("is_active")
  cards        InsuranceCard[]
  claims       InsuranceClaim[]
  createdAt    DateTime        @default(now()) @map("created_at")

  @@map("insurance_companies")
}

model InsuranceCard {
  id          Int              @id @default(autoincrement())
  patientId   Int              @map("patient_id")
  patient     Patient          @relation(fields: [patientId], references: [id])
  companyId   Int              @map("company_id")
  company     InsuranceCompany @relation(fields: [companyId], references: [id])
  cardNumber  String           @map("card_number")
  policyType  String?          @map("policy_type")
  coveragePercent Decimal?     @db.Decimal(5, 2) @map("coverage_percent")
  maxCoverage Decimal?         @db.Decimal(12, 2) @map("max_coverage")
  validFrom   DateTime?        @map("valid_from")
  validTo     DateTime?        @map("valid_to")
  isActive    Boolean          @default(true) @map("is_active")

  @@map("insurance_cards")
}

model InsuranceClaim {
  id          Int              @id @default(autoincrement())
  claimNumber String           @unique @map("claim_number")
  invoiceId   Int              @unique @map("invoice_id")
  invoice     Invoice          @relation(fields: [invoiceId], references: [id])
  companyId   Int              @map("company_id")
  company     InsuranceCompany @relation(fields: [companyId], references: [id])
  claimedAmount Decimal        @db.Decimal(12, 2) @map("claimed_amount")
  approvedAmount Decimal?      @db.Decimal(12, 2) @map("approved_amount")
  status      ClaimStatus      @default(SUBMITTED)
  rejectionReason String?      @map("rejection_reason")
  submittedAt DateTime         @default(now()) @map("submitted_at")
  resolvedAt  DateTime?        @map("resolved_at")

  @@map("insurance_claims")
}

enum ClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  PAID
}

// ============= ARCHIVE & DOCUMENTS =============
model Archive {
  id          Int       @id @default(autoincrement())
  patientId   Int?      @map("patient_id")
  patient     Patient?  @relation(fields: [patientId], references: [id])
  title       String
  description String?
  category    ArchiveCategory
  fileType    String    @map("file_type")
  fileName    String    @map("file_name")
  filePath    String    @map("file_path")
  fileSize    Int       @map("file_size")
  uploadedBy  Int       @map("uploaded_by")
  uploader    User      @relation("uploader", fields: [uploadedBy], references: [id])
  tags        String?
  accessLogs  ArchiveAccessLog[]
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("archives")
}

enum ArchiveCategory {
  MEDICAL_REPORT
  LAB_RESULT
  RADIOLOGY_IMAGE
  SURGICAL_CONSENT
  DISCHARGE_SUMMARY
  REFERRAL_LETTER
  INSURANCE_DOCUMENT
  DEATH_CERTIFICATE
  BIRTH_CERTIFICATE
  ID_DOCUMENT
  CONTRACT
  OTHER
}

model ArchiveAccessLog {
  id         Int      @id @default(autoincrement())
  archiveId  Int      @map("archive_id")
  archive    Archive  @relation(fields: [archiveId], references: [id])
  userId     Int      @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  action     String
  accessedAt DateTime @default(now()) @map("accessed_at")

  @@map("archive_access_logs")
}

// ============= HR =============
model Shift {
  id          Int       @id @default(autoincrement())
  employeeId  Int       @map("employee_id")
  employee    Employee  @relation(fields: [employeeId], references: [id])
  shiftDate   DateTime  @map("shift_date")
  startTime   String    @map("start_time")
  endTime     String    @map("end_time")
  shiftType   String    @map("shift_type")
  notes       String?

  @@map("shifts")
}

model Attendance {
  id          Int       @id @default(autoincrement())
  employeeId  Int       @map("employee_id")
  employee    Employee  @relation(fields: [employeeId], references: [id])
  date        DateTime
  checkIn     DateTime? @map("check_in")
  checkOut    DateTime? @map("check_out")
  status      AttendanceStatus @default(PRESENT)
  notes       String?

  @@map("attendance")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  SICK_LEAVE
}

// ============= SETTINGS =============
model HospitalSettings {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  value       String
